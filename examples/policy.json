{
  "version": 1,
  "allowedList": [
    "vicfei"
  ],
  "botList": [
    "github-actions",
    "dependabot"
  ],
  "acceptMode": "observe",
  "merge": {
    "enabled": false,
    "requireApprovalCoveringHead": true,
    "maxChangedLines": 200,
    "method": "squash",
    "deleteBranch": true,
    "requireCi": false
  },
  "table": [
    {
      "scope": "issue",
      "listedNotAddressing": "inferred",
      "unlistedAddressing": "ignore",
      "unlistedNotAddressing": "ignore"
    },
    {
      "scope": "issue_comment",
      "listedNotAddressing": "inferred",
      "unlistedAddressing": "ignore",
      "unlistedNotAddressing": "ignore"
    },
    {
      "scope": "pr",
      "listedNotAddressing": "inferred",
      "unlistedAddressing": "ignore",
      "unlistedNotAddressing": "ignore"
    },
    {
      "scope": "pr_comment",
      "listedNotAddressing": "inferred",
      "unlistedAddressing": "ignore",
      "unlistedNotAddressing": "ignore"
    },
    {
      "scope": "review_comment",
      "listedNotAddressing": "inferred",
      "unlistedAddressing": "ignore",
      "unlistedNotAddressing": "ignore"
    },
    {
      "scope": "im_dm",
      "listedNotAddressing": "inferred",
      "unlistedAddressing": "ignore",
      "unlistedNotAddressing": "ignore"
    },
    {
      "scope": "im_group",
      "listedNotAddressing": "inferred",
      "unlistedAddressing": "ignore",
      "unlistedNotAddressing": "ignore"
    },
    {
      "scope": "ci",
      "listedNotAddressing": "ignore",
      "unlistedAddressing": "ignore",
      "unlistedNotAddressing": "ignore"
    }
  ],
  "watchdog": {
    "enabled": false,
    "stuckWorkingNudgeMs": 1800000,
    "needsPersonReminderMs": 86400000,
    "consultLlm": false
  },
  "speculation": {
    "enabled": false,
    "maxSpeculative": 1
  },
  "approval": {
    "enabled": false
  }
}
