{
  "name": "@vicfei/dsh-super-agent",
  "version": "0.5.1",
  "description": "Admission control, observe mode & tickets for any CLI coding agent — independent implementation of the DeepSeek Super-agent design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vicfei/dsh-super-agent.git"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && cp src/panel.html dist/panel.html",
    "poll": "tsx src/cli.ts poll",
    "tickets": "tsx src/cli.ts tickets",
    "work": "tsx src/cli.ts work",
    "panel": "tsx src/cli.ts panel",
    "watch": "tsx src/cli.ts watch",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dsh-super-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs/demo.gif",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
